# ===========================================
# DolyOutfits POS - Production Environment
# ===========================================

# -------------------------------------------
# Convex Backend (Set in Convex Dashboard)
# -------------------------------------------
# Go to: Convex Dashboard → Settings → Environment Variables
SITE_URL=https://your-domain.com

# -------------------------------------------
# Next.js Frontend (Set in Dokploy)
# -------------------------------------------
# Your server URL (where Dokploy deploys)
NEXT_PUBLIC_APP_URL=https://your-domain.com

# Convex Deployment URLs (from Convex Dashboard → Settings → URL)
NEXT_PUBLIC_CONVEX_URL=https://your-app.convex.cloud
NEXT_PUBLIC_CONVEX_SITE_URL=https://your-app.convex.site

# -------------------------------------------
# Docker Configuration (Set in Dokploy)
# -------------------------------------------
# Application port (default: 3000)
APP_PORT=7000

# -------------------------------------------
# Optional: Convex Deploy Key (for CI/CD)
# -------------------------------------------
# CONVEX_DEPLOY_KEY=your-deploy-key-here

# ===========================================
# Example for your setup (15.235.143.107:7000)
# ===========================================

# In Dokploy:
# NEXT_PUBLIC_APP_URL=http://15.235.143.107:7000
# NEXT_PUBLIC_CONVEX_URL=https://your-app.convex.cloud
# NEXT_PUBLIC_CONVEX_SITE_URL=https://your-app.convex.site
# APP_PORT=7000

# In Convex Dashboard:
# SITE_URL=http://15.235.143.107:7000